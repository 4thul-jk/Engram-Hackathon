# Default mode works without Atlas. Its records are in memory and reset on restart.
STORE=memory
HOST=127.0.0.1
PORT=4317
# Replace both tokens before exposing the service. Keep these on your team's backend.
ADMIN_TOKEN=local-admin-change-me
COMPANION_TOKEN=local-companion-change-me
HOUSEHOLD_ID=demo-household
SUBJECT_IDS=margaret
TIMEZONE=Europe/London
ALLOWED_ORIGINS=http://localhost:3000
WORKER_INTERVAL_MS=2000
PROMPT_COOLDOWN_SECONDS=30
QUIET_START=22:00
QUIET_END=07:00
# Local demo runs a worker in the server process. Atlas may instead use npm run worker.
RUN_WORKER=true

# Atlas configuration: requires npm install, cluster credentials and indexes.
# STORE=mongodb
# MONGODB_URI=mongodb+srv://...
MONGODB_DATABASE=engram
SEARCH_INDEX=episodes_text
VECTOR_INDEX=episodes_auto
# Native fusion first; automatically falls back to standalone queries if it fails.
HYBRID_BACKEND=native
# Enable only after testing the project setting, deployment and model combination.
# Older 8.3 announcement uses rerank-2.5; current docs list newer requirements.
NATIVE_RERANK=false
NATIVE_RERANK_MODEL=rerank-2.5
# auto: Atlas Automated Embedding. manual: Voyage API embeddings + vector index.
EMBEDDING_MODE=auto
VOYAGE_EMBED_MODEL=voyage-4
VOYAGE_DIMENSIONS=1024
# Required for manual embeddings and optional reranking; never put in frontend code.
VOYAGE_API_KEY=
# Match the endpoint to your key's provider/geography.
VOYAGE_BASE_URL=https://ai.mongodb.com/v1
VOYAGE_RERANK=false
VOYAGE_RERANK_MODEL=rerank-3
# local: backend creates context candidates. atlas: Stream Processing must do it.
CONTEXT_PROCESSING=local
# Stream Processing Connection Registry name; used by stream:prepare only.
STREAM_CONNECTION_NAME=engramAtlas
# Backend only. Never expose these through frontend build variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-argon
